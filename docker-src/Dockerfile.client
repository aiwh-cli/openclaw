# AIWH OpenClaw Client Image (self-contained, multi-arch)
# Everything bundled inside — no host volume mounts needed
FROM node:22-slim

# System deps + build tools for native Node modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    curl jq git ffmpeg sqlite3 ca-certificates \
    build-essential python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Python packages
RUN python3 -m pip install --break-system-packages requests numpy cryptography

# Reuse existing node user (UID/GID 1000)
RUN usermod -l sandbox -d /home/sandbox -m node 2>/dev/null || true && \
    groupmod -n sandbox node 2>/dev/null || true

# Copy entire OpenClaw installation (node_modules installed separately for correct arch)
COPY openclaw-full/ /opt/openclaw/
RUN cd /opt/openclaw && npm install

# Install extension dependencies
RUN for ext in /opt/openclaw/extensions/*/package.json; do \
        dir=$(dirname "$ext"); \
        echo "Installing deps for $(basename $dir)..."; \
        cd "$dir" && npm install --omit=dev 2>/dev/null || true; \
    done

# Install package dependencies
RUN for pkg in /opt/openclaw/packages/*/package.json; do \
        dir=$(dirname "$pkg"); \
        echo "Installing deps for $(basename $dir)..."; \
        cd "$dir" && npm install --omit=dev 2>/dev/null || true; \
    done

# Copy AIWH core (product code)
COPY aiwh-core/ /opt/AIWH/core/

# Install dashboard dependencies (better-sqlite3 needs native compilation for Linux)
RUN cd /opt/AIWH/core/dashboard && npm install --omit=dev

# Make better-sqlite3 available to db-init.js (runs from core/scripts/)
RUN cd /opt/AIWH/core/scripts && ln -s ../dashboard/node_modules node_modules

# Create openclaw CLI wrapper (adapter expects /opt/homebrew/bin/openclaw)
RUN mkdir -p /opt/homebrew/bin && \
    printf '#!/bin/sh\nexec node /opt/openclaw/dist/index.js "$@"\n' > /opt/homebrew/bin/openclaw && \
    chmod +x /opt/homebrew/bin/openclaw

# Copy OpenClaw config
COPY openclaw-state/ /opt/AIWH/.openclaw/

# Create client data directory (writable at runtime)
RUN mkdir -p /opt/AIWH/client/data /opt/AIWH/client/config /opt/AIWH/client/content && \
    chown -R sandbox:sandbox /opt/AIWH

# Copy client config templates
COPY aiwh-client/ /opt/AIWH/client/

# Fix ownership after all copies
RUN chown -R sandbox:sandbox /opt/AIWH

USER sandbox
WORKDIR /opt/AIWH/core
EXPOSE 18789 3001

COPY --chmod=755 entrypoint.sh /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]
CMD ["gateway"]
